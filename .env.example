# Copy to .env and replace every value marked CHANGE_ME. Do not commit .env.
ENVIRONMENT=development
POSTGRES_DB=titoflix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@postgres:5432/titoflix

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
REDIS_URL=redis://redis:6379/0

# MinIO stays on the private Docker network. MEDIA_DATA_PATH can be a second disk.
MEDIA_DATA_PATH=./data/minio
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET_NAME=titoflix-media
S3_REGION=us-east-1
S3_MEDIA_PREFIX=media
S3_ASSETS_PREFIX=assets

CORS_ORIGINS=http://localhost:3000
INTERNAL_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DIRECT_API_URL=/api/v1
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_MAX_UPLOAD_SIZE=21474836480

# Mailpit is included for development. Set real SMTP credentials only in test.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=Titoflix <noreply@localhost>

# Reserved for the test environment; do not expose titoflix.watch yet.
CLOUDFLARE_TUNNEL_TOKEN=
