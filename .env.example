# Titoflix local development environment

# App
APP_NAME=Titoflix API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
HOST_IP=titoflix.watch

# PostgreSQL
POSTGRES_DB=titoflix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/titoflix

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=titoflix-admin
ADMIN_PASSWORD=admin1234

# MinIO / S3-compatible storage
MINIO_ROOT_USER=titoflix
MINIO_ROOT_PASSWORD=titoflix-secret
S3_ENDPOINT_URL=http://minio:9000
# MinIO is private behind Docker in the default setup. Keep this local unless
# you intentionally expose MinIO through its own public hostname.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=titoflix
S3_SECRET_KEY=titoflix-secret
S3_BUCKET_NAME=titoflix-media
S3_REGION=us-east-1
S3_MEDIA_PREFIX=media
S3_ASSETS_PREFIX=assets

# CORS
CORS_ORIGINS=https://titoflix.watch,https://www.titoflix.watch,http://localhost:3000,http://127.0.0.1:3000

# Frontend / Next.js
INTERNAL_BACKEND_URL=http://backend:8000
# Public browser calls stay relative so Cloudflare can serve the frontend and
# proxy /api/v1 through Next.js to the backend container.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DIRECT_API_URL=/api/v1
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760

# Cloudflare Tunnel
# Paste the Docker connector token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
